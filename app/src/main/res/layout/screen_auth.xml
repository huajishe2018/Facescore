<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            style="@style/FaceScorePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/hero_background"
            android:orientation="vertical">

            <com.example.facescore.StarChartView
                android:layout_width="match_parent"
                android:layout_height="116dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/auth_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:accessibilityHeading="true"
                android:textColor="@color/ink"
                android:textSize="28sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:autofillHints="username"
                android:hint="@string/auth_username"
                android:inputType="textVisiblePassword"
                android:maxLength="32"
                android:textColor="@color/ink"
                android:textColorHint="@color/secondary_text" />

            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:autofillHints="password"
                android:hint="@string/auth_password"
                android:inputType="textPassword"
                android:maxLength="128"
                android:textColor="@color/ink"
                android:textColorHint="@color/secondary_text" />

            <Button
                android:id="@+id/auth_submit"
                style="@style/FaceScorePrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/auth_switch"
                style="@style/FaceScoreSecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
