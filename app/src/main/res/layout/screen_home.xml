<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/hero_background"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="26dp">

            <com.example.facescore.StarChartView
                android:layout_width="match_parent"
                android:layout_height="212dp"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/home_title"
                android:text="@string/app_name"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:id="@+id/home_intro"
                android:text="@string/home_intro"
                android:gravity="center"
                android:textColor="@color/secondary_text"
                android:textSize="17sp" />

        </LinearLayout>

        <LinearLayout
            style="@style/FaceScorePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/score_mode"
                style="@style/FaceScoreSecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="颜值打分 · 本机" />

            <Button
                android:id="@+id/review_mode"
                style="@style/FaceScoreSecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="照片锐评 · 云端" />

            <Button
                android:id="@+id/choose_photo"
                style="@style/FaceScoreSecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/choose_photo" />

            <Button
                android:id="@+id/open_camera"
                style="@style/FaceScorePrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/open_camera" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
                android:id="@+id/mode_note"
            android:text="@string/photo_privacy"
            android:gravity="center"
            android:textColor="@color/secondary_text"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
